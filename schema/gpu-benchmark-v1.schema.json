{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy-m-testing.org/schema/gpu-benchmark-v1.schema.json",
  "title": "Offline versioned GPU benchmark document",
  "description": "Privacy-safe separate document, integer-only and machine-signed; never a hardware compatibility or CTS report.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "gpu-benchmark"
    },
    "schema_version": {
      "const": 1
    },
    "suite": {
      "const": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "omarchy-m-test"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.+-][0-9A-Za-z.+-]+)?$"
        }
      }
    },
    "machine": {
      "description": "What the Mac is. Model and chip come from the device tree, never from serial numbers or other per-unit identifiers.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "board",
        "soc",
        "chip",
        "arch",
        "kernel"
      ],
      "properties": {
        "model": {
          "description": "Device-tree model string, e.g. \"Apple MacBook Pro (16-inch, M2 Max, 2023)\".",
          "type": "string",
          "pattern": "^Apple ",
          "maxLength": 120
        },
        "board": {
          "description": "Board id from the device-tree compatible list, e.g. \"j416c\".",
          "type": "string",
          "pattern": "^j[0-9]{3}[a-z]{0,2}$"
        },
        "soc": {
          "description": "SoC id from the device-tree compatible list, e.g. \"t6021\".",
          "type": "string",
          "pattern": "^t[0-9]{4}$"
        },
        "chip": {
          "description": "Marketing chip name for the SoC, e.g. \"M2 Max\" or \"A18 Pro\"; \"unknown\" when the SoC isn't known yet.",
          "type": "string",
          "pattern": "^((M|A)[0-9]+( Pro| Max| Ultra)?|unknown)$"
        },
        "arch": {
          "const": "aarch64"
        },
        "kernel": {
          "description": "Kernel release (uname -r).",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "enum": [
                  "mesa",
                  "mesa-aurora",
                  "vulkan-asahi",
                  "vulkan-aurora",
                  "linux-aurora",
                  "linux-asahi",
                  "m1n1-aurora"
                ]
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9A-Za-z][0-9A-Za-z.+~:_-]{0,149}$"
              }
            },
            "required": [
              "name",
              "version"
            ]
          }
        },
        "firmware": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system": {
              "type": "string",
              "pattern": "^[0-9A-Za-z][0-9A-Za-z.+~:_-]{0,149}$"
            },
            "os": {
              "type": "string",
              "pattern": "^[0-9A-Za-z][0-9A-Za-z.+~:_-]{0,149}$"
            },
            "m1n1_stage2": {
              "type": "string",
              "pattern": "^[0-9A-Za-z][0-9A-Za-z.+~:_-]{0,149}$"
            }
          },
          "required": []
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "packages",
        "firmware"
      ]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warmups": {
          "const": 2
        },
        "repetitions": {
          "type": "integer",
          "minimum": 5,
          "maximum": 31
        },
        "order_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "declared_boot_block": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "boot_independence": {
          "const": "operator-declared-not-verified"
        },
        "cooldown_target_mc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "temperature_stop_mc": {
          "const": 85000
        },
        "cache_policy": {
          "const": "new-empty-private-cache-per-helper"
        },
        "quantiles": {
          "const": "R7-rounded-integer"
        },
        "uncertainty": {
          "const": "within-session-spread-only"
        },
        "api_scope": {
          "const": "native-vulkan-1.2-offscreen"
        },
        "multi_queue": {
          "const": "not-tested"
        },
        "vm_teardown": {
          "const": "not-isolated"
        },
        "upload": {
          "const": "never"
        }
      },
      "required": [
        "warmups",
        "repetitions",
        "order_seed",
        "declared_boot_block",
        "api_scope",
        "upload"
      ]
    },
    "controls": {
