<% content_for :title, @latest.short_model_name %>
<h1><%= @latest.short_model_name %></h1>
<p class="subtitle"><%= @latest.chip %> · <%= Catalogue.chip_name(@chip) %> generation · SoC <%= @latest.soc %> · board <%= @latest.board %></p>

<%= card "features" do %>
  <ol class="configuration-key" aria-label="Tested builds">
    <% @rows.each_with_index do |row, index| %>
      <li id="configuration-<%= index + 1 %>"><%= row.configuration.label %></li>
    <% end %>
  </ol>
  <div class="matrix-scroll">
    <table class="list features-table">
      <thead>
        <tr>
          <th scope="col">Feature</th><th scope="col">Asahi</th><th scope="col">Aurora</th><th scope="col">Omarchy</th>
          <% @rows.each_with_index do |row, index| %>
            <th class="config-head" scope="col"><a href="#configuration-<%= index + 1 %>" title="<%= row.configuration.label %>" aria-label="Build <%= index + 1 %>: <%= row.configuration.label %>">#<%= index + 1 %></a></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @matrix.features.each do |feature| %>
          <% expected = Catalogue.expected(feature, @chip, @latest.board) %>
          <tr id="feature-<%= feature["id"] %>">
            <td><a href="<%= feature_path(feature["id"]) %>"><%= feature["name"] %></a> <span class="layer layer-<%= feature["layer"] %>"><%= feature["layer"] %></span></td>
            <% Catalogue::LAYERS.each do |layer| %>
              <td class="<%= expected_class(layer, expected&.dig(layer)) %>"><%= expected_words(expected&.dig(layer)) %></td>
            <% end %>
            <% @rows.each do |row| %>
              <% cell = row.cell(feature["id"]) %>
              <%= matrix_cell(cell, feature_id: feature["id"], link: cell.reports.first && report_path(cell.reports.first),
                              context: [ feature["name"], "#{row.model_name} · #{row.configuration.label}" ]) %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/legend" %>
  <p class="credit dim">Asahi states: <a href="https://asahilinux.org/docs/platform/feature-support/overview/">Asahi Linux feature support</a>, CC BY 3.0.</p>
<% end %>

<% if @benchmarks.any? %>
  <%= card "benchmarks", id: "benchmarks" do %>
    <table class="list benchmark-table">
      <thead><tr><th>Benchmark</th><th>Stack / version</th><th class="score-head">Score</th><th>Machines</th><th>Tool</th></tr></thead>
      <tbody>
        <% @benchmarks.each do |benchmark| %>
          <% benchmark.rows_for_board(@latest.board).each do |row| %>
            <tr class="score-row" data-benchmark="<%= benchmark.id %>" data-stack="<%= row.configuration.stack %>" data-version="<%= row.configuration.version %>" data-build="<%= row.configuration.build_id %>">
              <td><a href="<%= benchmarks_path(anchor: "benchmark-#{benchmark.id}") %>"><%= benchmark.name %></a> <span class="dim">suite <%= benchmark.suite %></span></td>
              <td><%= row.configuration.label %></td>
              <td class="score-cell">
                <span class="score-bar" style="--share: <%= benchmark.best.positive? ? (100.0 * row.median / benchmark.best).round(1) : 0 %>%"></span>
                <a class="score-value" href="<%= report_path(row.latest.report) %>"><%= score_words(row.median) %></a> <span class="dim"><%= benchmark.unit_words %></span>
              </td>
              <td><%= row.machines %></td>
              <td class="dim nowrap"><%= row.tools.join(", ") %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
    <p class="dim">Bars are against the best Mac on the same benchmark. <a href="<%= benchmarks_path %>">Compare every Mac</a>.</p>
  <% end %>
<% end %>

<%= card "reports" do %>
  <%= render "shared/report_list", reports: @rows.flat_map(&:reports).sort_by(&:created_at).reverse %>
<% end %>
