<%# locals: (rows:, features:, history: nil) %>
<div class="matrix-scroll">
  <table class="matrix<%= " matrix-grouped" if history %>">
    <thead>
      <tr>
        <th class="row-head" scope="col"><%= history ? "Mac · stack · latest results" : "Mac · stack / version · build" %></th>
        <% features.each do |feature| %>
          <th class="feature-head layer-<%= feature["layer"] %>" scope="col">
            <a href="<%= feature_path(feature["id"]) %>" title="<%= feature["name"] %> (<%= Catalogue::LAYER_WORDS[feature["layer"]] %>)"><span><%= feature["name"] %></span></a>
          </th>
        <% end %>
      </tr>
    </thead>
    <% rows.each do |row| %>
      <% builds = history&.fetch([ row.configuration.board, row.configuration.stack ], []) %>
      <% history_id = "builds-#{row.configuration.board}-#{row.configuration.stack}" if history %>
      <tbody>
        <%= render "shared/matrix_row", row:, features:, summary: !!history, toggle_id: (history_id if history), builds_count: builds&.size || 0 %>
      </tbody>
      <% if history %>
        <tbody class="matrix-history" id="<%= history_id %>">
          <% builds.each do |build_row| %><%= render "shared/matrix_row", row: build_row, features:, history: true %><% end %>
        </tbody>
      <% end %>
    <% end %>
  </table>
</div>
